<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="OrangeHRM Sanity Test" thread-count="4"
	parallel="tests" verbose="4">

	<listeners>
		<listener
			class-name="com.qa.homePage.listeners.ExtentReportListener" />
		<listener
			class-name="com.qa.homePage.listeners.TestAllureListener" />
		<listener
			class-name="com.qa.homePage.listeners.AnnotationTransformer" />
			
			<listener
			class-name="com.qa.homePage.listeners.ItextPdfListener" />	
			
	</listeners>

	<test name="Home Page Test">
		<parameter name="browser" value="chrome" />
	
		<classes>
			<class name="com.qa.homePage.HomePageTest.java" />
		</classes>
	</test>

	

	<!-- <test name="Register Page Test">
